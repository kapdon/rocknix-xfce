+    /// Tiled/maximized/fullscreen clients must keep the compositor's allocation.
+    pub fn constrained_window_dims(&self, window: x::Window) -> Option<WindowDims> {
+        let entity = *self.windows.get(&window)?;
+        let data = self.world.entity(entity).ok()?;
+        let role = data.get::<&SurfaceRole>()?;
+        let SurfaceRole::Toplevel(Some(toplevel)) = &*role else { return None; };
+        if !toplevel.constrained { return None; }
+        Some(data.get::<&WindowData>()?.attrs.dims)
+    }
