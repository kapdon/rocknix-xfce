 /// See Pointer::handle_event for an explanation.
 #[test]
 fn popup_pointer_motion_workaround() {}
+
+#[test]
+fn compositor_constrained_resize_state() {
+    let (mut f, comp) = TestFixture::new_with_compositor();
+    let window = Window::new(1);
+    let (_, surface) = f.create_toplevel(&comp, window);
+    assert!(f.satellite.constrained_window_dims(window).is_none());
+    for state in [xdg_toplevel::State::TiledLeft, xdg_toplevel::State::TiledRight,
+                  xdg_toplevel::State::TiledTop, xdg_toplevel::State::TiledBottom,
+                  xdg_toplevel::State::Maximized, xdg_toplevel::State::Fullscreen] {
+        f.testwl.configure_toplevel(surface, 1920, 953, vec![state]);
+        f.run();
+        let dims = f.satellite.constrained_window_dims(window).unwrap();
+        assert_eq!((dims.width, dims.height), (1920, 953));
+    }
+    f.testwl.configure_toplevel(surface, 800, 600, vec![xdg_toplevel::State::Activated]);
+    f.run();
+    assert!(f.satellite.constrained_window_dims(window).is_none());
+}
