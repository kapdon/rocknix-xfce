#!/bin/bash
set -Eeuo pipefail
[[ ${1:-} =~ ^[1-9][0-9]{0,19}$ ]] || exit 2
[[ ${2:-} == close || ${2:-} == keep ]] || exit 2
source /etc/profile
# Identity/environment come from the host system service and ROCKNIX profile.
export XDG_RUNTIME_DIR=/run/0-runtime-dir WAYLAND_DISPLAY=wayland-1
export PULSE_SERVER=unix:/run/0-runtime-dir/pulse/native
# Shared SDR baseline: use ordinary XWayland presentation in both modes.
# The optional Gamescope WSI bypass can change swapchain image counts while
# switching paths. Its HDR/timing features are outside this baseline.
# The disable flag wins even if a child launcher enables the implicit layer.
export ENABLE_GAMESCOPE_WSI=0 DISABLE_GAMESCOPE_WSI=1
if [[ $2 == close ]]; then
  export SWAYSOCK=/run/0-runtime-dir/sway-ipc.0.sock
  # Let ROCKNIX create and manage its normal steam-bigpicture.scope.
  unset _STEAM_SCOPE
  # Prefer the native shortcut to preserve ROCKNIX per-game settings by filename.
  shortcut=$("$(dirname "$0")/rocknix-games" shortcut "$1")
  # Stock ROCKNIX chooses DRM, stops Sway, and applies its native game settings.
  exec /usr/bin/runemu.sh "$shortcut" -Psteam --core=steam --emulator=steam --controllers=""
fi
# ROCKNIX's full launcher selects DRM on this device. Keep Desktop needs a
# nested compositor, but can reuse the installed native scope/re-exec helper.
source /usr/bin/start_steam.sh
declare -F steam_scope_reexec_if_needed >/dev/null || {
  echo 'ROCKNIX Steam scope helper is unavailable' >&2
  exit 1
}
STEAM_MAIN_SCRIPT=$(readlink -f "$0")
_STEAM_SCOPE=${_STEAM_SCOPE:-}
TZ=${TZ:-}
steam_scope_reexec_if_needed "$@"
export STEAM_COMPAT_GRAPHICS_PROVIDER=/storage/.local/share/fex-emu/RootFS/ArchLinux/graphics_provider.json
export DISABLE_LSFGVK=1
unset DISPLAY MESA_LOADER_DRIVER_OVERRIDE VK_DRIVER_FILES VK_ICD_FILENAMES
export LD_LIBRARY_PATH=/storage/.local/share/Steam/lib/aarch64-linux-gnu
exec /usr/bin/gamescope --backend wayland -W 1280 -H 720 -w 1280 -h 720 -r 60 \
  --xwayland-count 2 --force-windows-fullscreen -- \
  /storage/.local/share/Steam/steamrtarm64/steam \
  -deckard -steamos3 -nobigpicture -noshaders -silent "steam://rungameid/$1"
