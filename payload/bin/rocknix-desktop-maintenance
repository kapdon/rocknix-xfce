#!/usr/bin/python3
"""Fail-closed host maintenance checks; no storage conversion or mutation."""
import os
from pathlib import Path
import subprocess

def require_games_idle():
    # The supervisor's flock ends before ExecStopPost. Its durable journal and
    # native scope keep maintenance excluded through cleanup/Desktop recovery.
    if os.path.lexists('/run/rocknix-desktop-games/session.json'):
        raise RuntimeError('finish Steam session recovery before maintenance')
    for unit in ('rocknix-desktop-games.service', 'steam-bigpicture.scope'):
        state = subprocess.run(
            ['systemctl', 'show', '--property=ActiveState', '--value', unit],
            capture_output=True, text=True, check=True).stdout.strip()
        if state not in ('inactive', 'failed'):
            raise RuntimeError('Steam must be fully inactive before maintenance')

def require_idle():
    require_games_idle()
    desktop = subprocess.run(
        ['systemctl', 'show', '--property=ActiveState', '--value', 'rocknix-desktop.service'],
        capture_output=True, text=True, check=True)
    if desktop.stdout.strip() != 'inactive':
        raise RuntimeError('Desktop Mode must be fully inactive before maintenance')
    for unit in ('sway.service', 'essway.service'):
        subprocess.run(['systemctl', 'is-active', '--quiet', unit], check=True)
    for name in ('rocknix-lxc', 'rocknix-lxc-upgrade', 'rocknix-lxc-access', 'rocknix-network'):
        if os.path.lexists(Path('/run') / name):
            raise RuntimeError(f'finish runtime cleanup first: /run/{name}')
    for status in Path('/proc').glob('[0-9]*/status'):
        try:
            line = next(line for line in status.read_text().splitlines() if line.startswith('Uid:'))
        except FileNotFoundError:
            continue
        if any(200000 <= int(uid) < 265536 for uid in line.split()[1:]):
            raise RuntimeError('mapped guest/maintenance processes are still running')
