#!/usr/bin/python3
"""Update LXC Desktop without replacing its Debian rootfs or private home.

The checksum establishes integrity, not publisher trust: bundles contain host
root code and must come from the trusted Desktop build. No old runtime/home
backup is made. An interrupted update stays guarded and resumes with the same
bundle; all guest commands execute through mapped LXC attach.
"""
import argparse
import fcntl
import grp
import hashlib
import json
import os
from pathlib import Path, PurePosixPath
import pwd
import re
import runpy
import shutil
import signal
import stat
import subprocess
import tarfile
import tempfile

PROJECT = Path('/storage/rocknix-desktop')
BASE = PROJECT / 'managed/host'
DATA = PROJECT / 'data'
ROOTFS = DATA / 'rootfs'
WORKSPACE = BASE / 'state'
GUARD = WORKSPACE / 'upgrade-in-progress.json'
STATE = Path('/run/rocknix-lxc-upgrade')
UNIT = Path('/storage/.config/system.d/rocknix-desktop.service')
HOOK = Path('/storage/.config/autostart/999-rocknix-desktop')
ENTRY = Path('/storage/.config/modules/Desktop Mode.sh')
FILES = {'build-info', 'desktop-integration.tar.gz', 'README.md', 'uninstall.sh',
         'upgrade.sh', 'upgrade-lxc.py'}
UPDATE_RESERVE = 256 * 1024**2


def helper_path(name):
    directory = Path(__file__).absolute().parent
    if Path(__file__).name == 'upgrade-lxc.py':
        # The same updater is copied beside upgrade.sh in a bundle and in the
        # installed host tree. Helpers themselves retain their payload/bin or
        # bin locations; they are never read from the guest rootfs.
        directory = directory / ('bin' if (directory / 'bin').is_dir() else 'payload/bin')
    path = directory / name
    safe_directory(directory)
    info = path.lstat()
    if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
        raise RuntimeError('unsafe updater helper')
    return path


def check_staging_space(target, members):
    """Reject known insufficient space before extracting or starting maintenance.

    Reserve is headroom, not a guarantee: guest package writes, filesystem
    metadata and concurrent storage users can still exhaust space later.
    The incoming replacement rootfs is deliberately excluded from the estimate.
    """
    staged = sum(((item.size + 4095) // 4096) * 4096 if item.isfile()
                 else 4096 for item in members)
    required = staged + UPDATE_RESERVE
    available = shutil.disk_usage(target).free
    if available < required:
        raise RuntimeError(f'insufficient update staging space: need at least '
                           f'{required} bytes, available {available}; '
                           'free space and retry with the same bundle')


def select_layout(project):
    """Require the complete canonical layout; never infer fresh guest data."""
    host = project / 'managed/host'
    if os.path.lexists(project / '.fresh-install.json'):
        raise RuntimeError('finish the guarded fresh installation before updating')
    if not all(os.path.lexists(path) for path in
               (host, host / 'state', project / 'data/rootfs', project / 'data/home')):
        raise RuntimeError('incomplete Desktop storage layout; run Install to replace Desktop data')
    return host, project / 'data', host / 'state', host / 'state/upgrade-in-progress.json'


def configure_layout():
    global BASE, DATA, ROOTFS, WORKSPACE, GUARD
    BASE, DATA, WORKSPACE, GUARD = select_layout(PROJECT)
    for path in (BASE, DATA, WORKSPACE):
        safe_directory(path)
    ROOTFS = DATA / 'rootfs'


def integration_bytes(source):
    """Render trusted native integration for the selected installation only."""
    content = source.read_bytes()
    content = content.replace(str(PROJECT / 'data/rootfs').encode(), str(ROOTFS).encode())
    return content.replace(str(PROJECT / 'managed/host').encode(), str(BASE).encode())


def safe_directory(path):
    for item in (path, *path.parents):
        info = item.lstat()
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
            raise RuntimeError(f'unsafe host directory: {item}')


def no_mounts(path):
    for line in Path('/proc/self/mountinfo').read_text().splitlines():
        mount = line.split()[4].replace('\\040', ' ')
        if mount == str(path) or mount.startswith(str(path) + '/'):
            raise RuntimeError(f'mounted data under {path}; recover the runtime first')


def validate_existing_storage(base):
    """Already-mapped LXC data is never recursively re-owned during updates."""
    safe_directory(base)
    for name, owner in (('rootfs', 200000), ('home', 201000)):
        info = (base / name).lstat()
        if not stat.S_ISDIR(info.st_mode) or (info.st_uid, info.st_gid) != (owner, owner):
            raise RuntimeError(f'expected mapped LXC {name} directory owned by {owner}')
    # Descendants legitimately include service accounts, guest-root-owned home
    # files and additional guest users. Their ownership is not ours to rewrite.


def retained_marker(host):
    marker = host / 'state/uninstalled.json'
    if not os.path.lexists(marker):
        return None
    safe_directory(marker.parent)
    info = marker.lstat()
    if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
        raise RuntimeError('unsafe retained-installation marker')
    record = json.loads(marker.read_text())
    if record.get('format') != 1 or record.get('phase') != 'removed':
        raise RuntimeError('finish interrupted uninstall before reinstalling')
    if set(record.get('files', {})) != {str(HOOK), str(ENTRY), str(UNIT)} or \
            any(not isinstance(value, str) or not re.fullmatch('[0-9a-f]{64}', value)
                for value in record['files'].values()):
        raise RuntimeError('invalid retained integration record')
    # A clean reinstall must not overwrite a replacement supplied by the user.
    # Interrupted updates instead follow their existing checksum-bound journal.
    if not os.path.lexists(GUARD):
        for path in (HOOK, ENTRY, UNIT):
            if os.path.lexists(path):
                raise RuntimeError(f'integration appeared after uninstall: {path}')
    return marker


def idle():
    desktop = subprocess.run(
        ['systemctl', 'show', '--property=ActiveState', '--value', 'rocknix-desktop.service'],
        capture_output=True, text=True, check=True)
    if desktop.stdout.strip() != 'inactive':
        raise RuntimeError('Desktop Mode must be fully inactive before updating')
    for unit in ('sway.service', 'essway.service'):
        subprocess.run(['systemctl', 'is-active', '--quiet', unit], check=True)
    no_mounts(BASE)
    if DATA != BASE:
        no_mounts(DATA)


def atomic(path, data, mode=0o644):
    safe_directory(path.parent)
    if path.is_symlink() or (path.exists() and not path.is_file()):
        raise RuntimeError(f'unsafe managed host destination: {path}')
    fd, name = tempfile.mkstemp(prefix='.rocknix-update-', dir=path.parent)
    temporary = Path(name)
    try:
        with os.fdopen(fd, 'wb') as stream:
            stream.write(data)
            os.fchmod(stream.fileno(), mode)
            os.fsync(stream.fileno())
        temporary.replace(path)
        fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(fd)
        finally:
            os.close(fd)
    finally:
        temporary.unlink(missing_ok=True)


def extract(bundle, expected, target):
    """Extract trusted host components, never an incoming replacement rootfs."""
    if bundle.suffix == '.json':
        with bundle.open('rb') as stream:
            if hashlib.file_digest(stream, 'sha256').hexdigest() != expected:
                raise RuntimeError('component manifest checksum mismatch')
        components = runpy.run_path(str(helper_path('rocknix-components')))
        value = components['release'](json.loads(bundle.read_text()))
        files = components['materialize'](value, bundle.parent / 'components',
                                          'kapdon/rocknix-desktop', 'update')
        assembled = target / 'components-candidate'
        components['assemble'](value, files, assembled, 'update')
        # The union payload is streamed through mapped LXC later. Do not copy
        # the staged guest files onto the installed writable Debian filesystem.
        shutil.rmtree(assembled / 'rootfs')
        for source in assembled.iterdir():
            source.rename(target / source.name)
        assembled.rmdir()
        return validate_candidate(target)
    with bundle.open('rb') as stream:
        if hashlib.file_digest(stream, 'sha256').hexdigest() != expected:
            raise RuntimeError('bundle checksum mismatch')
        stream.seek(0)
        with tarfile.open(fileobj=stream, mode='r:xz') as archive:
            selected = []
            seen = set()
            for member in archive.getmembers():
                name = member.name.removeprefix('./').rstrip('/')
                path = PurePosixPath(name)
                if not name or name == '.':
                    continue
                if path.is_absolute() or '..' in path.parts or str(path) != name:
                    raise RuntimeError('unsafe archive path')
                if not (name in FILES or path.parts[0] in ('payload', 'host-tools')):
                    continue
                if name in seen or not (member.isfile() or member.isdir() or member.issym() or member.islnk()):
                    raise RuntimeError('duplicate or special host archive member')
                seen.add(name)
                member.name = name
                selected.append(member)
            links = {item.name for item in selected if item.issym() or item.islnk()}
            regular = {item.name for item in selected if item.isfile()}
            for member in selected:
                if any(str(parent) in links for parent in PurePosixPath(member.name).parents):
                    raise RuntimeError('archive attempts to write through a link')
                if member.issym() and not member.name.startswith('host-tools/'):
                    raise RuntimeError('host payload symlink is not allowed')
                if member.islnk():
                    link = member.linkname.removeprefix('./')
                    if not link.startswith('host-tools/') or link not in regular or '..' in PurePosixPath(link).parts:
                        raise RuntimeError('unsafe archive hardlink')
                    member.linkname = link
            # Absolute Debian symlinks are needed inside the independently
            # sandboxed tools tree. No file may be extracted below a link.
            check_staging_space(target, selected)
            archive.extractall(target, members=selected, filter='fully_trusted')
    return validate_candidate(target)


def validate_candidate(target):
    safe_directory(target / 'payload')
    safe_directory(target / 'host-tools')
    if not (target / 'payload/bin/rocknix-desktop-paths').is_file():
        raise RuntimeError('candidate is missing required Desktop paths')
    metadata = (target / 'build-info').read_text()
    revision = re.search(r'^commit=([0-9a-f]{40})$', metadata, re.M)
    if not revision or 'architecture=arm64\n' not in metadata:
        raise RuntimeError('invalid candidate provenance')
    with tarfile.open(target / 'desktop-integration.tar.gz') as integration:
        release = integration.extractfile('etc/rocknix-desktop-release').read().decode()
        info = integration.extractfile('etc/rocknix-desktop-build-info').read().decode()
        if 'ROCKNIX_LXC_RUNTIME=1\n' not in release or info != metadata:
            raise RuntimeError('candidate is not a matching LXC integration build')
    return revision[1]


def remove_stage(path):
    if path.parent != WORKSPACE or not path.name.startswith('upgrade-lxc.'):
        raise RuntimeError('unrecognized update staging path')
    safe_directory(path)
    no_mounts(path)
    shutil.rmtree(path)


def prune_host_files(destination, names):
    """Drop retired files only in a validated, project-managed payload directory."""
    obsolete = [path for path in destination.iterdir() if path.name not in names]
    for path in obsolete:
        if path.is_symlink() or not path.is_file() or os.path.ismount(path):
            raise RuntimeError('unexpected obsolete host payload member: ' + str(path))
    for path in obsolete:
        path.unlink()


def install_host(candidate, preserve_candidate=False):
    """Replace only the known host-managed files; never rootfs/home/logs."""
    profile_api = runpy.run_path(str(candidate / 'payload/bin/rocknix-device-profile'))
    profile = profile_api['resolve'](os.environ.get('ROCKNIX_UNTESTED_DEVICE_CONFIRMED') == '1')
    tools = BASE / 'host-tools'
    if tools.exists() or tools.is_symlink():
        safe_directory(tools)
        no_mounts(tools)
        shutil.rmtree(tools)
    if preserve_candidate:
        shutil.copytree(candidate / 'host-tools', tools, symlinks=True)
    else:
        (candidate / 'host-tools').rename(tools)
    for directory in ('bin', 'input', 'integration'):
        destination = BASE / directory
        destination.mkdir(exist_ok=True)
        safe_directory(destination)
        for source in (candidate / 'payload' / directory).iterdir():
            if not source.is_file() or source.is_symlink():
                raise RuntimeError('unexpected host payload member')
            data = integration_bytes(source) if directory == 'integration' else source.read_bytes()
            atomic(destination / source.name, data, 0o644 if directory == 'input' else 0o755)
        prune_host_files(destination, {source.name for source in
                                     (candidate / 'payload' / directory).iterdir()})
    for name in ('README.md', 'uninstall.sh', 'upgrade.sh', 'upgrade-lxc.py', 'build-info'):
        atomic(BASE / name, (candidate / name).read_bytes())
    for source, destination, mode in (
        (candidate / 'payload/systemd/rocknix-desktop.service', UNIT, 0o644),
        (BASE / 'integration/999-rocknix-desktop', HOOK, 0o755),
        (BASE / 'integration/Desktop Mode.sh', ENTRY, 0o755)):
        atomic(destination, integration_bytes(source), mode)
    subprocess.run(['systemctl', 'daemon-reload'], check=True)
    profile_api['save_consent'](profile, atomic, BASE / 'state/device.json')
    subprocess.run(['systemd-analyze', 'verify', str(UNIT)], check=True)
    subprocess.run([str(BASE / 'bin/rocknix-tools-metadata')], check=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--bundle', type=Path, required=True)
    parser.add_argument('--sha256', required=True)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument('--check', action='store_true')
    mode.add_argument('--yes', action='store_true')
    args = parser.parse_args()
    if os.geteuid() != 0 or os.uname().machine != 'aarch64':
        raise RuntimeError('requires ARM64 ROCKNIX host root')
    runpy.run_path(str(helper_path('rocknix-device-profile')))['require_identity'](
        os.environ.get('ROCKNIX_UNTESTED_DEVICE_CONFIRMED') == '1')
    if not re.search(r'^OS_NAME=[\"\']?ROCKNIX[\"\']?$', Path('/etc/os-release').read_text(), re.M):
        raise RuntimeError('requires ROCKNIX')
    if not re.fullmatch('[0-9a-f]{64}', args.sha256):
        raise RuntimeError('provide the trusted build checksum')
    runpy.run_path(str(helper_path('rocknix-install-power')))['require_power']()
    if any(200000 <= item.pw_uid < 265536 for item in pwd.getpwall()) or \
            any(200000 <= item.gr_gid < 265536 for item in grp.getgrall()):
        raise RuntimeError('container identity range conflicts with native accounts')
    fd = os.open('/storage/.rocknix-desktop-install.lock', os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'w') as lock:
        info = os.fstat(lock.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022 or info.st_nlink != 1:
            raise RuntimeError('unsafe shared installation lock')
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        configure_layout()
        idle()
        validate_existing_storage(DATA)
        retained = retained_marker(BASE)
        if 'ROCKNIX_LXC_RUNTIME=1\n' not in (ROOTFS / 'etc/rocknix-desktop-release').read_text():
            raise RuntimeError('installed Desktop LXC runtime marker is invalid')
        guard = GUARD
        previous = None
        if guard.exists() or guard.is_symlink():
            if guard.is_symlink() or guard.stat().st_uid != 0:
                raise RuntimeError('unsafe update journal')
            previous = json.loads(guard.read_text())
            if previous.get('format') != 1 or previous.get('sha256') != args.sha256:
                raise RuntimeError('resume the interrupted update with its original bundle/checksum')
        candidate = Path(tempfile.mkdtemp(prefix='upgrade-lxc.', dir=WORKSPACE))
        keep = False
        runtime = None
        try:
            revision = extract(args.bundle, args.sha256, candidate)
            packages = candidate / 'payload/guest/trash-packages.tar'
            package_updater = candidate / 'payload/guest/update-trash-packages.py'
            if not packages.is_file() or not package_updater.is_file():
                raise RuntimeError('candidate lacks the required guest package update payload')
            api = runpy.run_path(str(candidate / 'payload/bin/rocknix-lxc'))
            if STATE.exists():
                if not previous or args.check:
                    raise RuntimeError('unfinished maintenance container requires update resume')
                old = Path(previous['work'])
                if old.parent != WORKSPACE or not old.name.startswith('upgrade-lxc.'):
                    raise RuntimeError('unrecognized previous staging path')
                safe_directory(old)
                tools = old / 'host-tools' if (old / 'host-tools').exists() else BASE / 'host-tools'
                api['Runtime'](tools, ROOTFS, STATE, recovery_only=True).recover()
            print(f'Candidate: {revision}; rootfs, apps and home will stay in place.', flush=True)
            if args.check:
                return
            record = {'format': 1, 'sha256': args.sha256, 'commit': revision,
                      'work': str(candidate), 'phase': 'maintenance'}
            atomic(guard, (json.dumps(record) + '\n').encode(), 0o600)
            keep = True
            if previous and Path(previous['work']) != candidate:
                remove_stage(Path(previous['work']))
            runtime = api['Runtime'](candidate / 'host-tools', ROOTFS, STATE)
            runtime.start()
            result = runtime.attach('/usr/bin/python3', '-', timeout=120,
                input=(candidate / 'payload/guest/check-container.py').read_text())
            if result.returncode:
                raise RuntimeError('installed container is invalid: ' + result.stdout + result.stderr)
            print(result.stdout, flush=True)
            result = runtime.attach('/bin/bash', '-s', '--', '--retained', timeout=300,
                input=(candidate / 'payload/guest/bootstrap-container.sh').read_text())
            if result.returncode:
                raise RuntimeError('container bootstrap failed: ' + result.stdout + result.stderr)
            with packages.open('rb') as stream:
                subprocess.run(runtime.command('lxc-attach', '-P', runtime.configs, '-n', runtime.name,
                    '--clear-env', '--', '/bin/sh', '-ec', 'cat > /run/desktop-packages.tar'),
                    stdin=stream, check=True, timeout=120)
            result = runtime.attach('/usr/bin/unshare', '--net', '/usr/bin/python3', '-',
                                    '/run/desktop-packages.tar', input=package_updater.read_text(), timeout=300)
            if result.returncode:
                raise RuntimeError('container package update failed: ' + result.stdout + result.stderr)
            print(result.stdout, flush=True)
            with (candidate / 'desktop-integration.tar.gz').open('rb') as stream:
                subprocess.run(runtime.command('lxc-attach', '-P', runtime.configs, '-n', runtime.name,
                    '--clear-env', '--', '/bin/sh', '-ec', 'cat > /run/desktop-integration.tar.gz'),
                    stdin=stream, check=True, timeout=120)
            updater = candidate / 'payload/guest/rocknix-container-update'
            result = runtime.attach('/usr/bin/python3', '-', '/run/desktop-integration.tar.gz',
                                    input=updater.read_text(), timeout=180)
            if result.returncode:
                raise RuntimeError('container integration update failed: ' + result.stdout + result.stderr)
            print(result.stdout, flush=True)
            conflicts = json.loads(result.stdout)['preserved_local_edits']
            if any(name.startswith('etc/systemd/') for name in conflicts):
                raise RuntimeError('resolve preserved systemd configuration before activation: ' + ', '.join(conflicts))
            runtime.close()
            runtime = None
            record['phase'] = 'installing-host'
            atomic(guard, (json.dumps(record) + '\n').encode(), 0o600)
            install_host(candidate)
            subprocess.run([str(BASE / 'bin/preflight')], check=True,
                           env={**os.environ, 'ROCKNIX_UPGRADE_CHECK': '1'})
            if retained is not None:
                retained.unlink()
            guard.unlink()
            os.sync()
            keep = False
            print('LXC update complete. Apps and home retained; open Tools > Desktop Mode.', flush=True)
        finally:
            if runtime is not None:
                runtime.close()
            if not keep:
                remove_stage(candidate)
            else:
                print(f'Update guarded; rerun with the same bundle to resume. Candidate staging: {candidate}', flush=True)


if __name__ == '__main__':
    def interrupted(signum, frame):
        raise SystemExit(128 + signum)
    signal.signal(signal.SIGTERM, interrupted)
    signal.signal(signal.SIGINT, interrupted)
    main()
