# syntax=docker/dockerfile:1

FROM --platform=$BUILDPLATFORM debian@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a AS ffmpeg-cross-builder

ARG TARGETARCH

RUN test "${TARGETARCH}" = "arm64" \
    && dpkg --add-architecture arm64 \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       build-essential \
       ca-certificates \
       gcc-aarch64-linux-gnu \
       libc6-dev-arm64-cross \
       libdrm-dev:arm64 \
       libudev-dev:arm64 \
       patch \
       pkg-config \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

FROM ffmpeg-cross-builder AS ffmpeg-rpi-builder
ADD --checksum=sha256:f864a7d595b7d7ad50e2600c5002efa824e939cac941ebde487bf326f80f533a \
  https://github.com/RPi-Distro/ffmpeg/archive/2fe08f3bd52c6e795df8353d29deb89596b5099d.tar.gz \
  /tmp/ffmpeg-rpi.tar.gz
COPY build-support/ffmpeg/build.sh /usr/local/bin/build-firefox-ffmpeg
RUN chmod 0755 /usr/local/bin/build-firefox-ffmpeg \
    && /usr/local/bin/build-firefox-ffmpeg

FROM ffmpeg-cross-builder AS mpv-ffmpeg-builder
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends devscripts equivs g++-aarch64-linux-gnu
ADD --checksum=sha256:de668509caf9e35e3cd162473441fdb29538c6d96ed080292b3cf9e6fc5d558f \
    https://deb.debian.org/debian/pool/main/f/ffmpeg/ffmpeg_7.1.5.orig.tar.xz /tmp/ffmpeg_7.1.5.orig.tar.xz
ADD --checksum=sha256:a1be51d8a10744952fe94fa318bf71bbc8074bed0951382c079ab7ef227f74ef \
    https://deb.debian.org/debian/pool/main/f/ffmpeg/ffmpeg_7.1.5-0+deb13u1.debian.tar.xz /tmp/ffmpeg_7.1.5-0+deb13u1.debian.tar.xz
COPY build-support/mpv-ffmpeg/build.sh /tmp/mpv-ffmpeg/build.sh
RUN sh /tmp/mpv-ffmpeg/build.sh prepare
COPY build-support/mpv-ffmpeg/*.patch /tmp/mpv-ffmpeg/
RUN sh /tmp/mpv-ffmpeg/build.sh

FROM --platform=$BUILDPLATFORM debian@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a AS keyboard-builder
ARG TARGETARCH
RUN test "${TARGETARCH}" = "arm64" \
    && dpkg --add-architecture arm64 \
    && apt-get update \
    && apt-get install -y --no-install-recommends build-essential gcc-aarch64-linux-gnu \
       libc6-dev-arm64-cross libwayland-dev:arm64 libxkbcommon-dev:arm64 \
       libpango1.0-dev:arm64 libwayland-bin pkg-config python3 patch ca-certificates
ADD --checksum=sha256:e3f82302367cdacf7a0c59d6d1bb4f5140083da1b3083da7c835dab0c250034c \
    https://github.com/jjsullivan5196/wvkbd/archive/refs/tags/v0.17.tar.gz /tmp/wvkbd.tar.gz
COPY build-support/wvkbd/002-output.patch build-support/wvkbd/003-no-popup.patch \
     build-support/wvkbd/customize.py build-support/wvkbd/symbols.h /tmp/wvkbd-custom/
RUN mkdir /tmp/wvkbd \
    && tar -xzf /tmp/wvkbd.tar.gz --strip-components=1 -C /tmp/wvkbd \
    && cd /tmp/wvkbd \
    && patch -p1 < /tmp/wvkbd-custom/002-output.patch \
    && patch -p1 < /tmp/wvkbd-custom/003-no-popup.patch \
    && python3 /tmp/wvkbd-custom/customize.py /tmp/wvkbd \
    && PKG_CONFIG_LIBDIR=/usr/lib/aarch64-linux-gnu/pkgconfig:/usr/share/pkgconfig \
       make -j4 CC=aarch64-linux-gnu-gcc wvkbd-mobintl \
    && aarch64-linux-gnu-strip wvkbd-mobintl

# Local artifact exports add per-run provenance.json beside the package payload.
# Select the stable audited files so attestations do not invalidate installation.
# Keep full build logs/udebs/checksums/provenance in the original build export.
# Only installed packages and distributed sources belong in this input layer.
FROM scratch AS trash-package-inputs
COPY --from=trash-packages /*.deb /*.dsc /*.tar.* /*.buildinfo /*.changes /

FROM --platform=$BUILDPLATFORM debian@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a AS xwayland-builder
ARG TARGETARCH
RUN test "${TARGETARCH}" = "arm64" && dpkg --add-architecture arm64 \
    && apt-get update && apt-get install -y --no-install-recommends \
       cargo rustc libstd-rust-dev:arm64 gcc-aarch64-linux-gnu libc6-dev-arm64-cross \
       pkg-config ca-certificates libclang-dev libxcb1-dev:arm64 \
       libxcb-cursor-dev:arm64 libxkbcommon-dev:arm64 libwayland-dev:arm64
ADD --checksum=sha256:8b32873d7d740143ce9efa3cfb43c17d0176b89d2e8ffaa497db709f154fc478 \
    https://github.com/Supreeeme/xwayland-satellite/archive/refs/tags/v0.8.3.tar.gz /tmp/satellite.tar.gz
RUN mkdir /tmp/satellite && tar -xzf /tmp/satellite.tar.gz --strip-components=1 -C /tmp/satellite
WORKDIR /tmp/satellite
ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc \
    PKG_CONFIG_ALLOW_CROSS=1 \
    PKG_CONFIG_LIBDIR=/usr/lib/aarch64-linux-gnu/pkgconfig:/usr/share/pkgconfig
RUN cargo build --locked --release --target aarch64-unknown-linux-gnu \
    && aarch64-linux-gnu-strip target/aarch64-unknown-linux-gnu/release/xwayland-satellite \
    && cargo vendor --locked /tmp/vendor >/tmp/vendor-config.toml \
    && tar -czf /tmp/vendor.tar.gz -C /tmp vendor vendor-config.toml

FROM debian@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a AS desktop-dependencies

ARG TARGETARCH

RUN test "${TARGETARCH}" = "arm64"

ENV DEBIAN_FRONTEND=noninteractive

# Bootstrap certificates through APT's signed-index/hash-verified HTTP path,
# then use HTTPS for runtime downloads (some HTTP caches serve stale .deb data).
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources

RUN printf '#!/bin/sh\nexit 101\n' >/usr/sbin/policy-rc.d \
    && chmod 0755 /usr/sbin/policy-rc.d \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       adwaita-icon-theme \
       alsa-utils \
       bash \
       ca-certificates \
       dbus \
       xdg-desktop-portal \
       xdg-desktop-portal-gtk \
       desktop-file-utils \
       fonts-dejavu-core \
       fonts-liberation \
       fonts-noto-color-emoji \
       fonts-noto-core \
       fonts-roboto \
       ffmpeg \
       firefox-esr \
       foot \
       fuzzel \
       glmark2-wayland \
       gvfs \
       gvfs-backends \
       iproute2 \
       less \
       libgl1-mesa-dri \
       libvulkan1 \
       mesa-utils \
       mesa-vulkan-drivers \
       mousepad \
       mpv \
       nano \
       pavucontrol \
       procps \
       pulseaudio-utils \
       qt6-wayland \
       ristretto \
       shared-mime-info \
       thunar \
       tumbler \
       vulkan-tools \
       waybar \
       wayland-utils \
       wl-clipboard \
       xdg-user-dirs \
       xdg-utils \
       xfce4-taskmanager \
    && rm -f \
       /usr/share/applications/firefox-esr.desktop \
       /usr/share/applications/foot-server.desktop \
       /usr/share/applications/footclient.desktop \
    && rm -f /usr/sbin/policy-rc.d \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && dpkg-query -W -f='${binary:Package}\t${Version}\n' | sort >/etc/rocknix-desktop-packages.tsv

# Keep dependency installation independent of Desktop overlay changes.
RUN printf '#!/bin/sh\nexit 101\n' >/usr/sbin/policy-rc.d \
    && chmod 0755 /usr/sbin/policy-rc.d \
    && apt-get update \
    && apt-get install -y --no-install-recommends sudo python3 python3-gi gir1.2-gtk-3.0 systemd systemd-sysv \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# X11 dependencies are part of every fresh guest base, including upgrades.
RUN apt-get update \
    && apt-get install -y --no-install-recommends xwayland x11-xkb-utils x11-utils \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY build-support/trash/check-packages.py build-support/trash/install-image.py /tmp/trash-tools/
# A named context supplied by build-rootfs.sh / the ARM64 release workflow.
# Python is present and no later APT step replaces the tested package family.
# Never overwrite libraries with a private prefix.
RUN --network=none --mount=from=trash-package-inputs,target=/tmp/trash-packages,ro \
    python3 /tmp/trash-tools/check-packages.py /tmp/trash-packages \
    && python3 /tmp/trash-tools/install-image.py /tmp/trash-packages \
    && mkdir -p /usr/local/share/rocknix-desktop/trash-source \
    && cp /tmp/trash-packages/*.dsc /tmp/trash-packages/*.tar.* \
       /tmp/trash-packages/*.buildinfo /tmp/trash-packages/*.changes \
       /usr/local/share/rocknix-desktop/trash-source/ \
    && rm -r /tmp/trash-tools \
    && dpkg-query -W -f='${binary:Package}\t${Version}\n' | sort >/etc/rocknix-desktop-packages.tsv

FROM desktop-dependencies AS desktop-compiled
COPY --from=xwayland-builder /tmp/satellite/target/aarch64-unknown-linux-gnu/release/xwayland-satellite /opt/rocknix-xwayland/bin/xwayland-satellite
COPY --from=xwayland-builder /tmp/satellite.tar.gz /opt/rocknix-xwayland/source/satellite.tar.gz
COPY --from=xwayland-builder /tmp/vendor.tar.gz /opt/rocknix-xwayland/source/vendor.tar.gz
COPY --from=xwayland-builder /tmp/satellite/LICENSE /opt/rocknix-xwayland/LICENSE

COPY --from=fuzzel-artifacts /opt/rocknix-fuzzel/ /opt/rocknix-fuzzel/
COPY --from=keyboard-builder /tmp/wvkbd/wvkbd-mobintl /usr/local/bin/wvkbd-rocknix
COPY --from=keyboard-builder /tmp/wvkbd/LICENSE /usr/local/share/wvkbd/LICENSE
COPY --from=keyboard-builder /tmp/wvkbd.tar.gz /usr/local/share/wvkbd/source.tar.gz
COPY build-support/wvkbd/ /usr/local/share/wvkbd/custom/
COPY --from=ffmpeg-rpi-builder /opt/ffmpeg-rpi-7.1.5/ /opt/ffmpeg-rpi-7.1.5/
COPY --from=mpv-ffmpeg-builder /opt/rocknix-mpv/ /opt/rocknix-mpv/
# Distribute the exact source (including the RPi patch) and build/adjustment
# script beside our privately rebuilt LGPL libraries, not only an upstream URL.
COPY --from=ffmpeg-rpi-builder /tmp/ffmpeg-rpi.tar.gz /opt/ffmpeg-rpi-7.1.5/share/source/ffmpeg-rpi.tar.gz
COPY --from=ffmpeg-rpi-builder /usr/local/bin/build-firefox-ffmpeg /opt/ffmpeg-rpi-7.1.5/share/source/build.sh

# Configuration and project files change frequently; keep them after all
# package installation and compiled dependency/source distribution layers.
# Independently exported release components; ordinary config builds never load
# these targets when the immutable compressed artifacts already exist.
FROM desktop-dependencies AS guest-base
COPY rootfs-overlay/usr/local/bin/rocknix-default-password /tmp/rocknix-default-password
COPY rootfs-overlay/etc/systemd/system/rocknix-desktop-session.service /etc/systemd/system/rocknix-desktop-session.service
COPY build-support/components/bootstrap-base.sh /tmp/bootstrap-base.sh
RUN sh /tmp/bootstrap-base.sh && rm /tmp/bootstrap-base.sh

FROM scratch AS xwayland-component
COPY --from=xwayland-builder /tmp/satellite/target/aarch64-unknown-linux-gnu/release/xwayland-satellite /opt/rocknix-xwayland/bin/xwayland-satellite
COPY --from=xwayland-builder /tmp/satellite.tar.gz /opt/rocknix-xwayland/source/satellite.tar.gz
COPY --from=xwayland-builder /tmp/vendor.tar.gz /opt/rocknix-xwayland/source/vendor.tar.gz
COPY --from=xwayland-builder /tmp/satellite/LICENSE /opt/rocknix-xwayland/LICENSE


FROM scratch AS firefox-component
COPY --from=ffmpeg-rpi-builder /opt/ffmpeg-rpi-7.1.5/ /opt/ffmpeg-rpi-7.1.5/
COPY --from=ffmpeg-rpi-builder /tmp/ffmpeg-rpi.tar.gz /opt/ffmpeg-rpi-7.1.5/share/source/ffmpeg-rpi.tar.gz
COPY --from=ffmpeg-rpi-builder /usr/local/bin/build-firefox-ffmpeg /opt/ffmpeg-rpi-7.1.5/share/source/build.sh

FROM scratch AS mpv-component
COPY --from=mpv-ffmpeg-builder /opt/rocknix-mpv/ /opt/rocknix-mpv/

FROM scratch AS keyboard-component
COPY --from=keyboard-builder /tmp/wvkbd/wvkbd-mobintl /usr/local/bin/wvkbd-rocknix
COPY --from=keyboard-builder /tmp/wvkbd/LICENSE /usr/local/share/wvkbd/LICENSE
COPY --from=keyboard-builder /tmp/wvkbd.tar.gz /usr/local/share/wvkbd/source.tar.gz
COPY build-support/wvkbd/ /usr/local/share/wvkbd/custom/

FROM desktop-compiled AS desktop-apps
COPY rootfs-overlay/ /

RUN chmod 0755 \
      /usr/sbin/policy-rc.d \
      /usr/local/bin/rocknix-version \
      /usr/local/bin/rocknix-return \
      /usr/local/bin/rocknix-keyboard-toggle \
      /usr/local/bin/rocknix-launcher \
      /usr/local/bin/rocknix-display-menu \
      /usr/local/bin/rocknix-games \
      /usr/local/bin/rocknix-display-metrics \
      /usr/local/bin/rocknix-fuzzel \
      /usr/local/bin/rocknix-network-settings \
      /usr/local/bin/rocknix-status \
      /usr/local/bin/rocknix-window-switcher \
      /usr/local/bin/rocknix-firefox \
      /usr/local/bin/mpv \
      /usr/local/bin/rocknix-sway-session \
      /usr/local/bin/rocknix-lxc-session \
      /usr/local/bin/rocknix-fex /usr/local/bin/FEX \
    && mkdir -p \
      /home/rocknix-default/Desktop \
      /home/rocknix-default/.config \
      /run \
      /storage/Desktop \
      /storage/Steam \
      /storage/backup \
      /storage/games-external \
      /storage/games-internal \
    && cp /usr/share/applications/rocknix-return.desktop /home/rocknix-default/Desktop/ \
    && cp /usr/share/applications/rocknix-keyboard.desktop /home/rocknix-default/Desktop/ \
    && cp /usr/share/applications/rocknix-about.desktop /home/rocknix-default/Desktop/ \
    && chmod 0755 /home/rocknix-default/Desktop/*.desktop \
    && chmod 1777 /tmp \
    && rm -f /etc/machine-id

# Writable system-container runtime. Native ROCKNIX does not run any executable
# from this tree with host-root privileges; LXC uses separate trusted host tools.
FROM desktop-apps AS lxc-desktop
RUN chmod 0755 /usr/local/bin/rocknix-container-update /usr/local/bin/rocknix-default-password \
    && useradd --create-home --uid 1000 --shell /bin/bash --groups sudo rocknix \
    && passwd --lock root \
    && /usr/local/bin/rocknix-default-password \
    && rm -f /usr/sbin/policy-rc.d \
    && systemctl set-default multi-user.target \
    && systemctl enable rocknix-desktop-session.service \
    && systemctl mask getty.target console-getty.service NetworkManager.service \
       NetworkManager-wait-online.service systemd-networkd.service \
       systemd-networkd.socket systemd-networkd-wait-online.service \
       sys-kernel-config.mount sys-kernel-debug.mount systemd-firstboot.service \
    && mkdir -p /etc/systemd/journald.conf.d \
    && printf '[Journal]\nStorage=volatile\nRuntimeMaxUse=32M\n' \
       > /etc/systemd/journald.conf.d/rocknix-container.conf \
    && printf 'ROCKNIX_LXC_RUNTIME=1\n' >> /etc/rocknix-desktop-release \
    && rm -f /etc/machine-id /var/lib/dbus/machine-id \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && dpkg-query -W -f='${binary:Package}\t${Version}\n' | sort >/etc/rocknix-desktop-packages.tsv
